# Choose ONE driver. If neither is set the app runs in localStorage-only demo mode
# (signup/login disabled, server returns 503 on state writes).

# Driver A: Vercel KV / Upstash Redis (REST, recommended for Vercel deploys)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Driver B: native Redis (self-host)
REDIS_URL=

# Session secret used to sign cookies (32+ random bytes hex)
SESSION_SECRET=

# AI chat-assistent: API key voor Claude. Zonder deze key werkt /uren/chat niet,
# de rest van de app draait gewoon door.
ANTHROPIC_API_KEY=
# Optioneel: model override. Default is claude-opus-4-7. Voor minder kosten op
# routine-vragen kan claude-haiku-4-5 (~5x goedkoper) ook prima werken.
ANTHROPIC_MODEL=

# Toegangsbeleid:
#   - Publieke /signup is alleen bereikbaar zolang er nog GEEN gebruikers
#     in KV staan (bootstrap). Dat eerste account wordt automatisch beheerder.
#   - Daarna kunnen nieuwe accounts ALLEEN worden aangemaakt door een
#     ingelogde beheerder via /admin.
#
# Noodingang: e-mailadressen in ADMIN_EMAILS worden ALTIJD als beheerder
# behandeld, ook als hun KV-record dat niet meer aangeeft. Zo kun je
# jezelf herstellen na een ongelukkige demotie.
ADMIN_EMAILS=
