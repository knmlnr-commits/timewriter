# Choose ONE driver. If neither is set the app runs in localStorage-only demo mode
# (signup/login disabled, server returns 503 on state writes).

# Driver A: Vercel KV / Upstash Redis (REST, recommended for Vercel deploys)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Driver B: native Redis (self-host)
REDIS_URL=

# Session secret used to sign cookies (32+ random bytes hex)
SESSION_SECRET=

# Optional: comma-separated email allowlist. If set, only these emails can sign up.
SIGNUP_ALLOWLIST=
